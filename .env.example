# Сховище зображень. Без цього файлу docker-compose використовує локальний
# MinIO (див. дефолти в docker-compose.yml). Щоб перейти на Cloudflare R2:
#   cp .env.example .env   і підстав свої значення (.env у .gitignore).
#
# R2 → Create bucket → Settings → Public access (r2.dev або свій домен) →
# Manage API Tokens → токен з правами Object Read & Write.

# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=<назва бакета>
# S3_ACCESS_KEY_ID=<з панелі R2>
# S3_SECRET_ACCESS_KEY=<з панелі R2>
# S3_PUBLIC_URL=https://pub-<hash>.r2.dev
