generator client {
  provider = "prisma-client-js"
}

// У Prisma 7 конекшн-стрінг більше не живе тут: для Migrate він у
// prisma.config.ts, а для рантайм-клієнта — в driver adapter
// (src/lib/prisma.ts). Тут лишається тільки тип бази.
datasource db {
  provider = "postgresql"
}

// Персонал, що логіниться в адмінку. Покупці (Customer) — окрема
// модель, з'явиться на Етапі 4 разом із замовленнями.
enum Role {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  name         String
  createdAt    DateTime @default(now())
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      ProductStatus @default(DRAFT)
  vendor      String?
  variants    ProductVariant[]
  images      ProductImage[]
  customFields ProductCustomField[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  sku          String   @unique
  price        Decimal  @db.Decimal(10, 2)
  inventoryQty Int      @default(0)
  createdAt    DateTime @default(now())
  orderItems   OrderItem[]

  // productId постійно фільтрується (картка товару тягне свої варіанти) —
  // саме випадок з Index Lab, де індекс на зовнішньому ключі окупається.
  @@index([productId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  url       String
  position  Int    @default(0)

  @@index([productId])
}

// Довільні пари "ключ-значення" на товарі — на кшталт Shopify metafields
// ("матеріал", "гарантія, міс." тощо), без потреби міняти схему під
// кожне нове поле.
model ProductCustomField {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  key       String
  value     String

  // Один і той самий ключ на товарі двічі — це вже не "custom field",
  // а плутанина; unique заразом дає БД-рівневу гарантію.
  @@unique([productId, key])
  @@index([productId])
}

// Покупець. Окрема модель від User: покупці не логіняться в адмінку
// (немає passwordHash), і навіть коли з'явиться публічна вітрина,
// це буде інша "особа" в системі з іншими правами.
model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  orders    Order[]
  tickets   Ticket[]
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber Int         @unique @default(autoincrement())
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  status      OrderStatus @default(PENDING)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Список замовлень фільтрують за статусом і сортують за датою —
  // той самий складений індекс, що довів свою користь в Index Lab.
  @@index([status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  // Ціна на МОМЕНТ покупки, а не поточна ціна варіанта — інакше зміна
  // прайсу заднім числом переписала б історію вже оплачених замовлень.
  price     Decimal        @db.Decimal(10, 2)

  @@index([orderId])
}

enum TicketStatus {
  OPEN
  PENDING_CUSTOMER
  CLOSED
}

enum TicketAuthorType {
  CUSTOMER
  STAFF
}

model Ticket {
  id         String          @id @default(cuid())
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id])
  subject    String
  status     TicketStatus    @default(OPEN)
  messages   TicketMessage[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

model TicketMessage {
  id         String           @id @default(cuid())
  ticketId   String
  ticket     Ticket           @relation(fields: [ticketId], references: [id])
  authorType TicketAuthorType
  body       String
  createdAt  DateTime         @default(now())

  @@index([ticketId])
}
