generator client {
  provider = "prisma-client-js"
}

// У Prisma 7 конекшн-стрінг більше не живе тут: для Migrate він у
// prisma.config.ts, а для рантайм-клієнта — в driver adapter
// (src/lib/prisma.ts). Тут лишається тільки тип бази.
datasource db {
  provider = "postgresql"
}

// Персонал, що логіниться в адмінку. Покупці (Customer) — окрема
// модель, з'явиться на Етапі 4 разом із замовленнями.
enum Role {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  name         String
  createdAt    DateTime @default(now())
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      ProductStatus @default(DRAFT)
  vendor      String?
  variants    ProductVariant[]
  images      ProductImage[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  sku          String   @unique
  price        Decimal  @db.Decimal(10, 2)
  inventoryQty Int      @default(0)
  createdAt    DateTime @default(now())

  // productId постійно фільтрується (картка товару тягне свої варіанти) —
  // саме випадок з Index Lab, де індекс на зовнішньому ключі окупається.
  @@index([productId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  url       String
  position  Int    @default(0)

  @@index([productId])
}
